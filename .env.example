# Copy to .env. Every value here has a working default in config/settings.py,
# so a fresh clone runs with no .env at all — this file exists to show you the
# knobs and to be the thing you edit before deploying.
#
# The settings marked [PRODUCTION] are checked at startup: outside development
# the app refuses to boot rather than run with the insecure default. See
# check_production_safety() in api/apps.py.

# ---- Environment ----
# "development" allows the insecure defaults below and turns Django's DEBUG on.
# Any other value enables HTTPS enforcement, disables the browsable API and the
# /docs page, and activates the startup safety checks.
ENVIRONMENT=development

# ---- Hosts ----
# Django rejects requests whose Host header is not listed (comma-separated).
# "*" is fine locally and is what lets your phone reach the dev server by LAN IP.
# [PRODUCTION] Must be real hostnames.
ALLOWED_HOSTS=*

# ---- Database ----
# SQLite by default (zero setup). Parsed by dj-database-url, so switching to
# Postgres is one line (plus `uv add "psycopg[binary]"`):
#   DATABASE_URL=postgres://user:password@localhost:5432/edawr
#
# Move to Postgres before taking real orders. SQLite serialises every write
# against the whole database and has no row locks, so the select_for_update()
# that stops the last unit of stock being sold twice is a no-op there.
DATABASE_URL=sqlite:///./edawr.db
DB_CONN_MAX_AGE=600

# ---- Auth ----
# Signing key for JWTs. MUST be a long random value in production — the default
# below is published in this repository, so anyone who knows an admin email
# could forge an admin token. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# [PRODUCTION] Must be changed.
JWT_SECRET=dev-only-insecure-secret-change-me-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Django's own secret, for CSRF and anything else Django signs. Give it its own
# value: one secret signing two different things means rotating it to fix a
# leaked API token also invalidates every CSRF token.
# [PRODUCTION] Must be set.
# DJANGO_SECRET_KEY=

# ---- Cache (throttle counters live here) ----
# The default is per-process memory, which means every rate limit is silently
# multiplied by your worker count — and the login limit is the only thing that
# makes a 4-digit rider PIN a credential rather than a formality.
# [PRODUCTION] Must be set once you run more than one worker.
# CACHE_URL=redis://localhost:6379/0

# ---- Rate limits (DRF syntax: <number>/<second|minute|hour|day>) ----
# How many proxies sit in front of this app. Every limit below depends on it:
# it decides which address DRF keys a rate limit on. Too high and you read an
# address the client forged, so the limits stop existing; too low and everyone
# behind one carrier NAT shares a single bucket.
# Defaults to 0 in development (runserver is reached directly) and 1 in
# production (Cloud Run adds exactly one hop). Raise it only if you put a CDN
# in front as well — same trust decision as TRUST_PROXY_SSL_HEADER below.
# NUM_PROXIES=1
# Both login endpoints, keyed by IP. Do not raise this without thinking about
# the 4-digit PIN behind it.
LOGIN_RATE_LIMIT=10/min
# Checkout writes rows and moves stock, and it is public.
CHECKOUT_RATE_LIMIT=12/hour
# Order tracking is polled by an open browser tab.
TRACKING_RATE_LIMIT=120/min
# Blanket backstop for every other anonymous request.
ANON_RATE_LIMIT=240/min

# ---- CORS ----
# Comma-separated origins allowed to call this API from a browser. Also used
# for CSRF_TRUSTED_ORIGINS. [PRODUCTION] Must name your real frontend origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- HTTPS (production only; ignored when ENVIRONMENT=development) ----
# Redirect HTTP to HTTPS. Turn off only if something in front already does it.
# SECURE_SSL_REDIRECT=true
# Trust X-Forwarded-Proto from the load balancer. Set false if the app is
# reachable directly, or a client can forge the header and defeat the redirect.
# TRUST_PROXY_SSL_HEADER=true
# HSTS, in seconds. One year. Browsers cache this, so it is hard to take back —
# start lower if you are not certain every subdomain can serve HTTPS.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=true

# ---- What this process serves ----
# Interactive API docs at /docs. A complete map of the API; on by default in
# development only.
# SERVE_API_DOCS=false
# Serve /uploads/ from Django. Single-threaded, no caching, no range requests —
# put nginx or object storage in front instead. On by default in development.
# SERVE_MEDIA=false

# ---- Uploads ----
# Directory (relative to backend/) where product images are written.
# Becomes MEDIA_ROOT; they are served at /uploads/<filename>.
UPLOAD_DIR=uploads
# Largest request body Django will parse, in bytes. The upload view enforces its
# own 5 MB image cap, but that check runs after the body is parsed.
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760

# ---- Commerce ----
# The economics of the store, read only by api/pricing.py. Money as strings:
# they are parsed to Decimal, and a float here would reintroduce the rounding
# error the Decimal columns exist to prevent.
FREE_DELIVERY_ABOVE=199.00
HANDLING_FEE=5.00
MIN_ORDER_VALUE=49.00

# ---- Delivery tiers ----
# Two speeds, and the customer picks which one they are paying for. The fee and
# the window move together: the cheap tier is cheap because the store can batch
# it, and batching is what the wider window buys.
#
# FREE_DELIVERY_ABOVE applies to BOTH tiers — past the threshold the choice of
# speed stops costing anything.
DELIVERY_FEE_INSTANT=15.00
DELIVERY_FEE_SLOW=5.00

# The window counted down on the tracking page. Each order snapshots the minutes
# of the tier it chose, so re-tuning a tier never rewrites what an existing
# customer was already told.
DELIVERY_PROMISE_MINUTES_INSTANT=15
DELIVERY_PROMISE_MINUTES_SLOW=45

# What a request naming no tier gets, and what an unrecognised tier falls back
# to. Keep this on the fast tier: silently downgrading someone's delivery speed
# is the failure you hear about from a complaint rather than from a log.
DEFAULT_DELIVERY_TYPE=instant

# Basket limits. Abuse guards, not merchandising: without them one request can
# ask the server to lock ten thousand product rows in a single transaction.
MAX_ITEMS_PER_ORDER=50
MAX_QUANTITY_PER_ITEM=20

# How many products one storefront request may return.
STORE_PAGE_SIZE=60
STORE_MAX_PAGE_SIZE=200

STORE_NAME=eDawr
STORE_CITY=Aizawl

# ---- Logging ----
# Readable lines in development, one JSON object per line in production.
LOG_LEVEL=INFO

# ---- Seed data (used by `manage.py seed` only) ----
SEED_ADMIN_EMAIL=admin@edawr.local
SEED_ADMIN_PASSWORD=admin1234
# PIN given to both sample riders, so the Expo app can sign in after seeding.
# Not "1234": the API itself rejects the obvious sequences.
SEED_RIDER_PIN=4813
