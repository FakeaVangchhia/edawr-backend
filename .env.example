# Copy to .env. Every value here has a working default in config/settings.py,
# so a fresh clone runs with no .env at all — this file exists to show you the
# knobs and to be the thing you edit before deploying.

# ---- Environment ----
# "development" allows the insecure defaults below and turns Django's DEBUG on.
# Any other value makes the app refuse to start unless JWT_SECRET is replaced.
ENVIRONMENT=development

# ---- Hosts ----
# Django rejects requests whose Host header is not listed (comma-separated).
# "*" is fine locally and is what lets your phone reach the dev server by LAN IP.
# Set real hostnames in production.
ALLOWED_HOSTS=*

# ---- Database ----
# SQLite by default (zero setup). Parsed by dj-database-url, so switching to
# Postgres is still one line (plus `uv add psycopg[binary]`):
#   DATABASE_URL=postgres://user:password@localhost:5432/edawr
DATABASE_URL=sqlite:///./edawr.db

# ---- Auth ----
# Signing key for JWTs, and Django's SECRET_KEY unless DJANGO_SECRET_KEY is set.
# MUST be a long random value in production, and at least 32 bytes or PyJWT will
# warn that it is too weak for HS256. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Rate limit on both login endpoints (admin and rider), keyed by IP. This is
# what keeps a 4-digit rider PIN from being brute-forced — do not raise it
# without thinking about that. DRF syntax: <number>/<second|minute|hour|day>.
LOGIN_RATE_LIMIT=10/min

# Optional: give Django its own secret instead of reusing JWT_SECRET.
# DJANGO_SECRET_KEY=

# ---- CORS ----
# Comma-separated origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Uploads ----
# Directory (relative to backend/) where product images are written.
# Becomes MEDIA_ROOT; they are served at /uploads/<filename>.
UPLOAD_DIR=uploads

# ---- Seed data (used by `manage.py seed` only) ----
SEED_ADMIN_EMAIL=admin@edawr.local
SEED_ADMIN_PASSWORD=admin1234
# PIN given to both sample riders, so the Expo app can sign in after seeding.
# Riders sign in with their phone number + this PIN.
SEED_RIDER_PIN=1234
