# Copy to .env. Every value here has a working default in config/settings.py,
# so a fresh clone runs with no .env at all — this file exists to show you the
# knobs and to document what each one costs you.
#
# **This is a development file, and it is never deployed.** `.env` is
# gitignored, so it is not in the repository Render clones, and nothing copies
# it to the instance; `load_dotenv()` in settings.py finds no file there and
# every value comes from the real environment. Production configuration is set
# on Render — four literals and five prompted values, with everything else left
# on the defaults below. See "Configuration in production" in deployment.md.
#
# Keep production values OUT of this file. It is what your machine runs
# against, and a laptop pointed at the production database is one
# `manage.py seed` away from deleting every row in it.
#
# The settings marked [PRODUCTION] are checked at startup: outside development
# the app refuses to boot rather than run with the insecure default. See
# check_production_safety() in api/apps.py.

# ---- Environment ----
# "development" allows the insecure defaults below and turns Django's DEBUG on.
# Any other value enables HTTPS enforcement, disables the browsable API and the
# /docs page, and activates the startup safety checks.
ENVIRONMENT=development

# ---- Hosts ----
# Django rejects requests whose Host header is not listed (comma-separated).
# "*" is fine locally and is what lets your phone reach the dev server by LAN IP.
# [PRODUCTION] Must be real hostnames.
ALLOWED_HOSTS=*

# ---- Database ----
# SQLite by default (zero setup). Parsed by dj-database-url. psycopg[binary] is
# already a dependency, so switching to Postgres is genuinely one line:
#   DATABASE_URL=postgres://user:password@localhost:5432/edawr
#
# On a managed Postgres add the TLS parameter, which dj-database-url passes
# through from the query string:
#   DATABASE_URL=postgres://user:pass@host:5432/edawr?sslmode=require
#
# **Production is Neon, and production wants the POOLED endpoint** — the host
# with `-pooler` in it. This app holds connections open (DB_CONN_MAX_AGE=600)
# across WEB_CONCURRENCY x GUNICORN_THREADS threads, and Neon's limit is on
# direct connections; the pooler exists so a long-lived server can hold handles
# without spending them.
#
# Use the DIRECT endpoint (drop `-pooler`) for `manage.py test` only. The test
# runner creates and drops a whole database, which the pooler handles badly:
# it caches a failed login after the drop, and an interrupted run leaves a
# half-migrated database the next run adopts instead of rebuilding.
#
# Move to Postgres before taking real orders. SQLite serialises every write
# against the whole database and has no row locks, so the select_for_update()
# that stops the last unit of stock being sold twice is a no-op there.
DATABASE_URL=sqlite:///./edawr.db
DB_CONN_MAX_AGE=600

# ---- Auth ----
# Signing key for JWTs. MUST be a long random value in production — the default
# below is published in this repository, so anyone who knows an admin email
# could forge an admin token. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# [PRODUCTION] Must be changed.
JWT_SECRET=dev-only-insecure-secret-change-me-before-deploying
JWT_ALGORITHM=HS256
# How long ONE token lasts.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# How long a SESSION may keep renewing itself, which is a different question.
# /api/auth/me mints a fresh token on every call - that is what keeps a manager
# signed in across a shift, and without a ceiling it also makes a token copied
# out of localStorage a permanent credential, renewable by whoever holds it. The
# `ait` claim records when the session began and survives every refresh; past
# this many hours from it, /me refuses and a real sign-in is required.
SESSION_MAX_HOURS=168

# Django's own secret, for CSRF and anything else Django signs. Give it its own
# value: one secret signing two different things means rotating it to fix a
# leaked API token also invalidates every CSRF token.
# [PRODUCTION] Must be set.
# DJANGO_SECRET_KEY=

# ---- Cache (throttle counters live here) ----
# The default is per-process memory, which means every rate limit is silently
# multiplied by your worker count — and the login limit is the only thing that
# makes a 4-digit rider PIN a credential rather than a formality.
# [PRODUCTION] Must be set once you run more than one worker.
# CACHE_URL=redis://localhost:6379/0

# ---- Rate limits (DRF syntax: <number>/<second|minute|hour|day>) ----
# How many proxies sit in front of this app. Every limit below depends on it:
# it decides which address DRF keys a rate limit on. Too high and you read an
# address the client forged, so the limits stop existing; too low and everyone
# behind one carrier NAT shares a single bucket.
# Defaults to 0 in development (runserver is reached directly) and 1 in
# production (Render's proxy adds exactly one hop). Raise it only if you put a
# CDN in front as well — same trust decision as TRUST_PROXY_SSL_HEADER below.
# NUM_PROXIES=1
# Both login endpoints, keyed by IP. Do not raise this without thinking about
# the 4-digit PIN behind it.
LOGIN_RATE_LIMIT=10/min
# Checkout writes rows and moves stock, and it is public.
CHECKOUT_RATE_LIMIT=12/hour
# Order tracking is polled by an open browser tab.
TRACKING_RATE_LIMIT=120/min
# Blanket backstop for every other anonymous request.
ANON_RATE_LIMIT=240/min
# Crash and CSP reports from the three clients. Public and unauthenticated,
# because a crash report is worth having precisely when nobody is signed in.
# Generous - a genuinely broken deploy produces a burst, and that burst is the
# signal - but bounded, because log storage anyone can write to costs money.
REPORT_RATE_LIMIT=60/min
# Authenticated staff: the admin console and the rider app, keyed per account.
# Before this existed, a valid token was an unmetered channel into every
# endpoint, because AnonRateThrottle stops applying the moment a request has
# credentials. Generous on purpose - both clients poll on a timer.
STAFF_RATE_LIMIT=600/min
# A rider reporting their position, and a customer sharing theirs. Separate
# buckets rather than a share of STAFF_RATE_LIMIT: a location loop stuck on a
# retry must not be able to spend the allowance the rider needs to accept an
# order. Telemetry should never be able to starve the work.
RIDER_LOCATION_RATE_LIMIT=30/min
CUSTOMER_LOCATION_RATE_LIMIT=30/min
# Customer sign-up and sign-in, keyed by IP. A separate budget from
# LOGIN_RATE_LIMIT on purpose: on a carrier NAT, one shopper mistyping their
# password must not eat the bucket a rider needs to start their shift.
CUSTOMER_AUTH_RATE_LIMIT=10/min
# A signed-in customer, keyed per account. Deliberately identical to
# ANON_RATE_LIMIT — signing in must not change how much of the API you can use.
CUSTOMER_RATE_LIMIT=240/min

# ---- CORS ----
# Comma-separated origins allowed to call this API from a browser.
# NOT used for CSRF_TRUSTED_ORIGINS: this project installs no CSRF middleware
# (see the note beside MIDDLEWARE in settings.py), so that setting would be
# inert. An earlier version of this comment claimed otherwise.
# [PRODUCTION] Must name your real frontend origin.
# Port 3000 is the storefront; 3001 is the admin console (a separate app in
# admin/, deployed separately). Both call this API from the browser, so both
# origins must be listed or the console renders empty with a CORS error.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# ---- HTTPS (production only; ignored when ENVIRONMENT=development) ----
# Redirect HTTP to HTTPS. Turn off only if something in front already does it.
# SECURE_SSL_REDIRECT=true
# Trust X-Forwarded-Proto from the load balancer. Set false if the app is
# reachable directly, or a client can forge the header and defeat the redirect.
# Read by BOTH layers on purpose: Django's SECURE_PROXY_SSL_HEADER and
# gunicorn's forwarded_allow_ips (config/gunicorn.py). One switch, so the two
# cannot be left disagreeing about whether there is a proxy in front.
# TRUST_PROXY_SSL_HEADER=true
# HSTS, in seconds. One year. Browsers cache this, so it is hard to take back —
# start lower if you are not certain every subdomain can serve HTTPS.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=true

# ---- What this process serves ----
# Interactive API docs at /docs. A complete map of the API; on by default in
# development only.
# SERVE_API_DOCS=false
# Serve /uploads/ from Django. Single-threaded, no caching, no range requests —
# put nginx or object storage in front instead. On by default in development.
# SERVE_MEDIA=false

# ---- Web server (gunicorn; production only — see config/gunicorn.py) ----
# Every one of these has a working default and each is explained where it is
# read. `manage.py runserver` ignores all of them: it is the development server,
# which is what its start-up warning is telling you.
#
# The port to listen on. Render injects this and requires it to be honoured;
# binding a fixed port instead is how a service builds, starts, then fails
# every health check.
# PORT=8080
# Worker processes. One per CPU, and Render's Starter instance has half of one;
# more on one core only duplicates memory.
# WEB_CONCURRENCY=1
# Threads per worker. WEB_CONCURRENCY × GUNICORN_THREADS is also the number of
# database connections one instance can hold, each kept DB_CONN_MAX_AGE seconds
# past its last use — raise it with the connection limit in mind, not just
# throughput.
# GUNICORN_THREADS=8
# Worker liveness check, in seconds. 0 disables it, which is correct wherever
# the platform enforces its own request timeout — Render's proxy does. Two
# timeouts means the shorter one wins silently, and it shows up as a restarted
# worker rather than as a slow endpoint. Never set it below your slowest
# request: that turns a slow query into a 502.
# GUNICORN_TIMEOUT=0
# Time to finish in-flight requests after SIGTERM. Keep it under the platform's
# shutdown grace period or deploys cut responses short. Render allows 30s, and
# waits a further 60s after the new instance is healthy before signalling at
# all, so 25 lets a checkout that is mid-transaction finish.
# GUNICORN_GRACEFUL_TIMEOUT=25
# Idle keep-alive. Raise above the idle timeout of any proxy in front, or the
# proxy reuses a connection this process just closed and the customer sees a 502.
# GUNICORN_KEEPALIVE=5
# Import the app once in the master, then fork. Also makes a configuration error
# fail once, loudly, instead of in a per-worker restart loop.
# GUNICORN_PRELOAD=true
# Recycle a worker after this many requests, to bound a slow memory leak. Off,
# because with one worker a recycle is a latency spike on whatever request is
# arriving. Set the jitter too, or workers recycle in lockstep.
# GUNICORN_MAX_REQUESTS=0
# GUNICORN_MAX_REQUESTS_JITTER=0
# Gunicorn's own log level, and whether it writes an access line per request.
# Access logging is off because Render's proxy already records every request in
# the dashboard; turn it on when you need a field it does not show.
# GUNICORN_LOG_LEVEL=info
# GUNICORN_ACCESS_LOG=false

# ---- Backups ----
# Where `manage.py backup_database` writes its pg_dump archives, and how many it
# keeps before pruning the oldest.
#
# THIS MUST NOT BE UPLOAD_DIR, OR ANYTHING BENEATH IT. Production runs
# SERVE_MEDIA=true, so Django serves every file under MEDIA_ROOT to anyone who
# asks - a dump written there would be a public download of every customer's
# name, phone number and address, reachable by guessing a filename. The command
# refuses to run rather than relying on this comment being read.
#
# **A local tool now.** Render's native runtime has no apt-get, so pg_dump is not
# there and this cannot run in the deployed service — production backups are
# Neon's point-in-time recovery. Run it from a machine that has the PostgreSQL
# client tools when you want a copy you hold yourself, which is worth doing
# before a risky migration. See deployment.md, Backups.
BACKUP_DIR=backups
BACKUP_KEEP=14

# ---- Uploads ----
# Directory (relative to backend/) where product images are written.
# Becomes MEDIA_ROOT; they are served at /uploads/<filename>.
#
# **On Render this must point at the mounted disk** — render.yaml sets it to
# /var/data/uploads. The rest of that filesystem is ephemeral, so images written
# anywhere else disappear on the next deploy.
UPLOAD_DIR=uploads
# Largest request body Django will parse, in bytes. The upload view enforces its
# own 5 MB image cap, but that check runs after the body is parsed.
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760

# ---- Commerce ----
# The economics of the store, read only by api/pricing.py. Money as strings:
# they are parsed to Decimal, and a float here would reintroduce the rounding
# error the Decimal columns exist to prevent.
FREE_DELIVERY_ABOVE=199.00
HANDLING_FEE=5.00
MIN_ORDER_VALUE=49.00

# ---- Delivery tiers ----
# Two speeds, and the customer picks which one they are paying for. The fee and
# the window move together: the cheap tier is cheap because the store can batch
# it, and batching is what the wider window buys.
#
# FREE_DELIVERY_ABOVE applies to BOTH tiers — past the threshold the choice of
# speed stops costing anything.
DELIVERY_FEE_INSTANT=15.00
DELIVERY_FEE_SLOW=5.00

# The window counted down on the tracking page. Each order snapshots the minutes
# of the tier it chose, so re-tuning a tier never rewrites what an existing
# customer was already told.
DELIVERY_PROMISE_MINUTES_INSTANT=15
DELIVERY_PROMISE_MINUTES_SLOW=45

# What a request naming no tier gets, and what an unrecognised tier falls back
# to. Keep this on the fast tier: silently downgrading someone's delivery speed
# is the failure you hear about from a complaint rather than from a log.
DEFAULT_DELIVERY_TYPE=instant

# ---- Automatic rider assignment ----
# true  = an order reaching Ready is given to the nearest available rider at
#         once; the rider app shows it as already theirs, no Accept tap.
# false = fall back to the pull feed, where every rider in range sees it and
#         whoever taps Accept first gets it.
# Either way a manager can still override with POST /api/orders/{id}/assign,
# and an order nobody can be found for stays Ready under ?stalled=true.
AUTO_ASSIGN_RIDER=true

# --- rider push notifications ---------------------------------------------
# Whether the store may wake a rider's phone when an order is assigned to them
# or lands in the feed. See api/push.py.
#
# Off by default. The rider app only registers a handset once its build has an
# EAS project id, so on a deployment where that has not happened yet there is
# nothing to notify and turning this on only buys an outbound call per order.
# Switch it on when the rider app ships.
#
# The poll is unaffected either way: a notification is a prompt to open the app,
# never how the order gets there.
PUSH_ENABLED=false

# Expo's push gateway. Only worth setting to point a staging environment at
# something that is not a third party's production service.
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# Only needed once the Expo project turns on enhanced push security, which makes
# the sender prove it owns the project. Unset means the request goes
# unauthenticated, which is Expo's default and works.
# EXPO_ACCESS_TOKEN=

# How long one send may sit on the socket. It runs on a worker thread, so
# exceeding it costs a missed buzz rather than a stalled request.
# PUSH_TIMEOUT_SECONDS=8

# ---- Live location ----
# How old a rider's last position may be and still be drawn as live.
#
# The rider app reports from the foreground, so a phone in a pocket stops
# sending and starts ageing. This is the line between "moving" and "last
# seen", not between working and not: past it the console shows the last known
# position with its age, and the customer's tracking page shows nothing rather
# than a marker that quietly stopped being true.
# LOCATION_STALE_SECONDS=90

# How long the per-order breadcrumb trail is kept, in days. It exists to settle
# "nobody came" after a failed delivery, which is a conversation that happens
# within days.
#
# **`manage.py prune_locations` is what enforces this, and it must be
# scheduled.** Nothing else deletes the trail, and a position history nothing
# deletes is a growing record of where customers live. See deployment.md.
# LOCATION_PING_RETENTION_DAYS=30

# Basket limits. Abuse guards, not merchandising: without them one request can
# ask the server to lock ten thousand product rows in a single transaction.
MAX_ITEMS_PER_ORDER=50
MAX_QUANTITY_PER_ITEM=20

# How many products one storefront request may return.
STORE_PAGE_SIZE=60
STORE_MAX_PAGE_SIZE=200

STORE_NAME=eDawr
STORE_CITY=Aizawl

# The wall-clock timezone the store trades in. Rows stay UTC; this is what the
# analytics endpoints group by, so "today's revenue" means the day the
# shopkeeper is having. Aizawl is UTC+5:30, so bucketing by UTC date would file
# every order placed after 18:30 local under tomorrow.
STORE_TIMEZONE=Asia/Kolkata

# ---- Logging ----
# Readable lines in development, one JSON object per line in production.
LOG_LEVEL=INFO

# ---- Seed data (used by `manage.py seed` only) ----
# ---- Store settings are NOT here ----
# Opening hours, the "pause new orders" switch, the delivery radius and the
# store's coordinates live in the `store_settings` table, not in this file.
# They are operational rather than commercial: they change within a shift, and
# the person changing them is behind the counter. Requiring a redeploy to pause
# checkout during a power cut means the shop keeps promising 15-minute delivery
# it cannot make. Edit them at /settings in the console, or through
# PATCH /api/settings.

SEED_ADMIN_EMAIL=admin@edawr.local
SEED_ADMIN_PASSWORD=admin1234
# PIN given to both sample riders, so the Expo app can sign in after seeding.
# Not "1234": the API itself rejects the obvious sequences.
SEED_RIDER_PIN=4813
