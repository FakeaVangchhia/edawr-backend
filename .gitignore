# uv-managed environment -- recreate with `uv sync`.
# NOTE: uv.lock is deliberately NOT ignored. It pins the exact dependency tree
# and must be committed so every machine installs the same versions.
.venv/

__pycache__/
*.py[cod]

.env
*.db
*.sqlite3
# WAL journal sidecars. Created because settings.py sets journal_mode=WAL so a
# read does not block behind a write in development.
*.db-shm
*.db-wal
uploads/

# pg_dump archives from `manage.py backup_database`. Never committed: a dump is
# a complete copy of every customer's name, phone number and address, and it
# does not stop being one because the repository is private.
backups/
*.dump

# Any other dotenv variant (.env.development, .env.local, ...). A backup copy of
# a dev .env still holds a database URL and two signing secrets.
.env.*
!.env.example
